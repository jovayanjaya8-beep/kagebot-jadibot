FROM node:22-slim
ENV PUPPETEER_SKIP_DOWNLOAD=true NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ffmpeg imagemagick webp python3 make g++ ca-certificates curl unzip \
    libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libjpeg62-turbo libgif7 librsvg2-2 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ARG APP_PARTS="1EmEXF-yYw3vcZo7IUVCw12YeSPafta0l 1yWFoi8-T6OJO8afp-3PZreoP1XIuh6Sp 1YaiIx_cTwfmhIt5E8zOGQWH9PwXaTXis 1bLeNlkdybledQYkdpRNZgUdU0JaWlKXC 1ObMaLPB97M1BBAkVAHRpgxsOHrNMyjDW 1M1PKVpA0dw8VRd4xlcGjrSers7KoDPXR 1Y4W6RRvdjhyeZCBG2yamgxMdWZG3lx5T 1I8fXlEJ-u473-DRJmlzh04fqFY_XwAff 1eKafzPchzVQp80u9ywy9feXH2_kTtIS8"
ARG APP_SHA256="cc6b5fe9c41b45dae73c4c2a346a42e48000a66c4aa172973f02c74524e7f2b6"
RUN rm -f /tmp/app.zip; for id in $APP_PARTS; do \
      curl -fsSL "https://drive.usercontent.google.com/download?id=${id}&export=download&confirm=t" >> /tmp/app.zip || exit 1; \
    done \
    && echo "$APP_SHA256  /tmp/app.zip" | sha256sum -c - \
    && unzip -q /tmp/app.zip -d /app \
    && rm /tmp/app.zip
RUN node /app/docker/fixdeps.cjs
RUN npm install --omit=dev --no-audit --no-fund
RUN sh /app/docker/probe.sh
EXPOSE 3000
CMD ["sh", "/app/start.sh"]
